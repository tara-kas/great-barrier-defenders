# Server-side settings. Copy to .env; never commit credentials.
# The browser lab requires these variables exported into its process (SETUP.md).

# Active browser Gemma service: replace with your actual vLLM /v1 endpoint.
GEMMA_BASE_URL=
GEMMA_MODEL=gemma-4-E4B-it
GEMMA_API_KEY=
GEMMA_DEPLOYMENT=unverified

# Google Interactions assistance and review.
GEMINI_API_KEY=
ARGON_MODEL=gemini-4-argon

# Native cuOpt adapter.
CUOPT_ADAPTER_URL=
CUOPT_API_KEY=
CUOPT_DEPLOYMENT=unverified

# Hosted gateway authentication; configure in deployment secret storage.
LAB_GATEWAY_TOKEN=

# Modal authentication belongs in your local/deployment secret configuration.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Optional Python Gemma client timeout (browser gateway uses 25 seconds).
GEMMA_TIMEOUT_S=60

# Optional independent Isaac stream / Python research dashboard.
ISAAC_SIM_HOST=
ISAAC_SIM_SIGNALLING_PORT=49100
ISAAC_SIM_MEDIA_PORT=47998
ISAAC_SIM_WEB_VIEWER_PORT=8210
DASHBOARD_PORT=8080
