# Copy to .env and fill in. Never commit .env (see CLAUDE.md section 8).

# --- Gemini / Interactions API (google-genai>=2.3.0) ---
GEMINI_API_KEY=

# Model IDs (copy exact strings from CLAUDE.md section 3; do not guess)
GEMINI_MODEL_LEAD_REASONING=gemini-4-argon
GEMINI_MODEL_MANAGED_SANDBOX=antigravity-preview-09-2026
GEMINI_MODEL_DEEP_RESEARCH=deep-research-preview-04-2026
GEMINI_MODEL_FAST_SUBAGENT=gemini-3.8-flash
GEMINI_MODEL_FAST_ROUTER=gemini-3.5-flash-lite
GEMINI_MODEL_LIVE_VOICE_VISION=gemini-3.8-live
GEMINI_MODEL_LIVE_EXTENDED_THINKING=gemini-3.8-live-extended-thinking
GEMINI_MODEL_IMAGE_4K=gemini-nano-banana-2.1
GEMINI_MODEL_IMAGE_FAST=gemini-3.1-flash-lite-image
GEMINI_MODEL_OPEN_EDGE=gemma-4-31b-it

# --- Isaac Sim stream (run by a teammate on a Linux/Windows RTX box; you connect as a viewer) ---
ISAAC_SIM_HOST=
ISAAC_SIM_SIGNALLING_PORT=49100
ISAAC_SIM_MEDIA_PORT=47998
ISAAC_SIM_WEB_VIEWER_PORT=8210

# --- Dashboard (camera + detections, map, decision log, link status) ---
DASHBOARD_PORT=8080

# --- Simulated acoustic link (bandwidth/latency cap for human-in-the-loop approvals) ---
ACOUSTIC_LINK_BANDWIDTH_KBPS=4
ACOUSTIC_LINK_LATENCY_MS=2000

# --- Gemma perception (dive loop). Must be local for a real dive, e.g. vLLM on the sim box ---
GEMMA_BASE_URL=http://localhost:8000/v1
GEMMA_MODEL=gemma-4-31b-it
GEMMA_API_KEY=
GEMMA_TIMEOUT_S=60

# --- Modal (GPU compute; account owned by a teammate, not you — ask before provisioning) ---
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
